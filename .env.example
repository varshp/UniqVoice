# .env.example
#
# Role: Template showing which environment variables are required.
# Copy this file to .env and fill in YOUR values:
#   cp .env.example .env
#
# ⚠ NEVER commit .env — it is listed in .gitignore.
# ⚠ NEVER put real values in THIS file — only key names.
# All secrets are loaded at runtime via os.getenv() (see Section 8, SPEC.md).

# ── Gemini / Google AI ─────────────────────────────────────────────────────────
# Obtain from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# ── Tavily Search MCP server ───────────────────────────────────────────────────
# Obtain from: https://tavily.com  (free tier ≈ 1 000 requests/month)
# Used by: trend_scout + serp_analyst via the search MCP
TAVILY_API_KEY=
